{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumafly",
  "version": "0.1.0",
  "identifier": "app.lumafly.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumafly",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-LLM Gmail triage",
    "longDescription": "Manages personal Gmail accounts with a locally hosted LLM. Classifies, summarizes, proposes actions for review, and unsubscribes. Nothing leaves your machine except Gmail API calls.",
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
